# Copy these values into your shell or an untracked .env file.
# Never commit real credentials.
FITPULSE_DB_URL=jdbc:mysql://localhost:3306/fitpulse2?createDatabaseIfNotExist=false&serverTimezone=UTC
FITPULSE_DB_USERNAME=fitpulse
FITPULSE_DB_PASSWORD=replace-with-a-local-password

# Optional Google OAuth web client. Leave both empty to hide Google sign-in.
FITPULSE_GOOGLE_CLIENT_ID=
FITPULSE_GOOGLE_CLIENT_SECRET=
# Optional when deployed behind a proxy. Must match the authorized URI in Google Cloud.
# FITPULSE_GOOGLE_REDIRECT_URI=https://fitpulse.example/login/oauth2/code/google
# Optional persistent directory outside the web root.
# FITPULSE_PROFILE_PHOTO_DIR=/var/lib/fitpulse/avatars
